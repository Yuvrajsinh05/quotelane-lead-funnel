# ---- Required ----
# Postgres connection string (use the *pooled* URL on Vercel).
DATABASE_URL=postgres://quotelane:quotelane@localhost:54329/quotelane
# >= 32 random chars. Derives the cookie-sealing key and the IP-hashing key.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=dev-only-secret-change-me-dev-only-secret-change-me

# ---- A/B split ----
# 0-100: share of NEW visitors assigned to variant B. 0 / 100 act as kill switches.
SPLIT_PERCENT_B=50

# ---- Partner delivery ----
# Leave empty to store leads without delivering (status = skipped_unconfigured).
PARTNER_WEBHOOK_URL=
# Optional: when set, requests are signed with X-QuoteLane-Signature (HMAC-SHA256).
PARTNER_WEBHOOK_SECRET=
PARTNER_TIMEOUT_MS=5000
# Optional per-channel source IDs agreed with the partner. Unknown channels use "default".
PARTNER_SOURCE_IDS={"default":"QL-WEB-001","email":"QL-EM-001","social":"QL-SO-001"}

# ---- Brand ----
BRAND_ID=quotelane
BRAND_CLICK_PREFIX=ql

# ---- Cron ----
# Vercel sends "Authorization: Bearer $CRON_SECRET" to cron routes automatically.
CRON_SECRET=dev-cron-secret

# ---- Tests ----
DATABASE_URL_TEST=postgres://quotelane:quotelane@localhost:54329/quotelane_test
